   "source": [
    "import numpy as np\n",
    "\n",
    "def find_p300_peak(erp, times, window=(0.25, 0.5)):\n",
    "    \"\"\"Return (latency_s, amplitude) of the max positive peak in the window.\"\"\"\n",
    "    mask = (times >= window[0]) & (times <= window[1])\n",
    "    idx = np.argmax(erp[mask])\n",
    "    return times[mask][idx], erp[mask][idx]"
   ]
  }
 ],
